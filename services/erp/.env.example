# ERP v2 environment — sample. Copy to .env and adjust.
# All values here are placeholders. Do NOT commit real secrets.

# --- Database --------------------------------------------------------------
ERP_DATABASE_URL=postgresql+asyncpg://erp:erp@localhost:5432/erp_db
ERP_TEST_DATABASE_URL=postgresql+asyncpg://erp:erp@localhost:5432/erp_db_test

# --- Service identity ------------------------------------------------------
ERP_VERSION=0.1.0
DEPLOY_ENV=dev
SERVICE_NAME=erp-v2
LOG_LEVEL=INFO

# --- OpenTelemetry ---------------------------------------------------------
# Set to a collector endpoint to ship spans. Leave blank for in-memory only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- W0: trust the x-user-id header (W1 swaps to JWT) ----------------------
# W1 will add:
#   ERP_JWT_SECRET=replace-me
#   ERP_JWT_ALGORITHM=HS256
#   ERP_JWT_ISSUER=https://auth.example.com
#   ERP_JWT_AUDIENCE=erp-v2
